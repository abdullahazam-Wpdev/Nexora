# Set in the shell for API and training CLI; absolute path required.
# NEXORA_STORAGE=/path/to/external-ssd/nexora
POSTGRES_USER=nexora
POSTGRES_DB=nexora
# scripts/infra.py creates a local password in ignored .secrets/postgres_password.
# Do not put secrets in frontend code, source control or command arguments.

# NVIDIA NIM hosted inference (https://build.nvidia.com). Get your own key;
# do not assume it is free or unlimited. See docs/NVIDIA_NIM.md.
# NVIDIA_NIM_API_KEY=nvapi-...
